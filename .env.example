# ============================================================================
# MediKiosk — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# ─── LLM Provider ─────────────────────────────────────────────────────────
# Options: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (alternative provider)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ─── Database ─────────────────────────────────────────────────────────────
# Development (SQLite — zero setup)
DATABASE_URL=sqlite+aiosqlite:///./medikiosk.db

# Production (PostgreSQL — uncomment and fill in)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/medikiosk

# ─── Cache (optional) ────────────────────────────────────────────────────
# Leave empty to use in-memory cache
REDIS_URL=

# ─── Storage ──────────────────────────────────────────────────────────────
# Local filesystem path for uploaded documents
STORAGE_PATH=./data/uploads

# ─── ABDM Integration ────────────────────────────────────────────────────
# Ayushman Bharat Digital Mission gateway
ABDM_API_URL=https://abdm-sandbox.nha.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# ─── API Security ────────────────────────────────────────────────────────
# Development-only API key for local kiosk/clinician JWTs.
# Replace with a managed high-entropy secret before any non-local deployment.
API_KEY=medikiosk-dev-secret-key-32chars-minimum-entropy

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Application ──────────────────────────────────────────────────────────
DEBUG=true
LOG_LEVEL=INFO
PORT=8000

# Session time-to-live in seconds (default: 1 hour)
SESSION_TTL_SECONDS=3600

# ─── CardioVision screening ────────────────────────────────────────────────
# mock is deterministic/offline for demos; real loads ./models/cardiovision.
CARDIOVISION_MODE=mock
CARDIOVISION_MODEL_DIR=./models/cardiovision
